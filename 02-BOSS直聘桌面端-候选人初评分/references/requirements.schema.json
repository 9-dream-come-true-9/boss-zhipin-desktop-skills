{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Extracted Job Requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_hash", "requirements"],
  "properties": {
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_pointer", "source_span", "field", "canonical_value", "value_type", "modality"],
        "properties": {
          "source_pointer": {"type": "string", "pattern": "^/"},
          "source_span": {"type": "string", "minLength": 1},
          "field": {"enum": ["education", "major", "availability", "desired_role", "experience_summary", "skills"]},
          "canonical_value": {"type": ["string", "integer", "number", "array", "object"]},
          "value_type": {"enum": ["education_at_least", "number_at_least", "positive_term_any", "positive_term_all"]},
          "modality": {"enum": ["required", "core", "preferred"]}
        }
      }
    }
  }
}
