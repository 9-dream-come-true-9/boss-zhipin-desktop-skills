{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResumeReceipt",
  "type": "object",
  "properties": {
    "job_key": {
      "type": "string"
    },
    "candidate_key": {
      "type": "string"
    },
    "candidate_name": {
      "type": "string"
    },
    "request_mode": {
      "enum": [
        "MESSAGE",
        "PLATFORM",
        "NONE"
      ]
    },
    "request_status": {
      "enum": [
        "NOT_REQUESTED",
        "SENT_VERIFIED",
        "REQUESTED_VERIFIED",
        "ALREADY_HANDLED",
        "COMMIT_UNKNOWN"
      ]
    },
    "quota_consumed": {
      "type": "boolean"
    },
    "resume_status": {
      "enum": [
        "NOT_RECEIVED",
        "RECEIVED",
        "DOWNLOADED",
        "PARSED"
      ]
    },
    "original_file": {
      "type": "string"
    },
    "file_size": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string"
    },
    "parse_status": {
      "type": "string"
    },
    "evidence": {
      "type": "array"
    },
    "accept_status": {
      "enum": [
        "NOT_CHECKED",
        "NO_PENDING_REQUEST",
        "ALREADY_ACCEPTED",
        "ACCEPTED_VERIFIED",
        "COMMIT_UNKNOWN"
      ]
    },
    "pending_attachment_requests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "job_key",
    "candidate_key",
    "candidate_name",
    "request_mode",
    "request_status",
    "quota_consumed",
    "resume_status",
    "original_file",
    "file_size",
    "sha256",
    "parse_status",
    "evidence"
  ],
  "additionalProperties": false
}